# Optiqo Backend — Environment Configuration Template
# Copy this file to .env and fill in any values you want to override.
# The backend works with all defaults as shown below.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Optiqo
APP_VERSION=0.1.0
APP_ENV=development   # development | staging | production

# ── API ──────────────────────────────────────────────────────────────────────
API_PREFIX=/api

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add your React dev server origin here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
